# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /workspace

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cmd/ag-helper/ cmd/ag-helper/

# Build the ag-helper binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o ag-helper \
    ./cmd/ag-helper

# Runtime stage
FROM gcr.io/distroless/static:nonroot

WORKDIR /

# Copy the binary from builder
COPY --from=builder /workspace/ag-helper .

# Use non-root user
USER 65532:65532

# Default port for health/ready endpoints
EXPOSE 8080

ENTRYPOINT ["/ag-helper"]
